{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Store orders and payment verifications"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "order_code": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "PENDING_PAYMENT",
        "PENDING_REVIEW",
        "PAID"
      ],
      "default": "PENDING_PAYMENT",
      "required": true
    },
    "total_amount_cents": {
      "type": "integer",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "LKR"
    },
    "customer_email": {
      "type": "email",
      "required": true
    },
    "items_snapshot": {
      "type": "json"
    },
    "shipping_details": {
      "type": "json"
    },
    "payment_slip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "payment_reference": {
      "type": "string"
    },
    "admin_notes": {
      "type": "text"
    },
    "verified_at": {
      "type": "datetime"
    }
  }
}
