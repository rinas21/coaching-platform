{
  "kind": "collectionType",
  "collectionName": "item_sales",
  "info": {
    "singularName": "item-sale",
    "pluralName": "item-sales",
    "displayName": "Store"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text"
    },
    "available_qty": {
      "type": "integer",
      "min": 0
    },
    "cta_label": {
      "type": "string",
      "default": "Add to cart"
    },
    "cta_link": {
      "type": "string",
      "default": "/checkout"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  }
}
