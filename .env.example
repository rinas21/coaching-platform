POSTGRES_PASSWORD=change_me_strong_password

# Local dev (non-Docker). With `docker compose up`, the compose file overrides DATABASE_URL / Strapi DB to use host `postgres`.
DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/safespace_app
STRAPI_DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/safespace_strapi
DATABASE_CLIENT=postgres

GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=LKR
PAYHERE_COUNTRY=LK
API_PUBLIC_URL=http://localhost:8000
PAYHERE_NOTIFY_URL=

# Store checkout: flat delivery/handling fee in cents (server uses CHECKOUT_SHIPPING_CENTS; UI must match NEXT_PUBLIC_CHECKOUT_SHIPPING_CENTS).
CHECKOUT_SHIPPING_CENTS=0
NEXT_PUBLIC_CHECKOUT_SHIPPING_CENTS=0

# Comma-separated browser origins allowed by the API (CORS). On a public server, add https://your-domain.com (and http://SERVER_IP:3000 while testing).
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Base URL of the Express API as seen BY THE BROWSER (not Docker-internal hostnames). localhost here only works if the user opens the site on the same machine running the API.
# Deploy example: NEXT_PUBLIC_API_URL=http://YOUR_VM_PUBLIC_IP:8000 or https://api.yourdomain.com — then rebuild the frontend image so Next embeds it (docker compose build frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side Strapi base (optional; overrides NEXT_PUBLIC_ for SSR / Docker internal hostname)
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_PAYHERE_CURRENCY=LKR
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/30min?hide_event_type_details=1&hide_gdpr_banner=1
NEXT_PUBLIC_WHATSAPP_BOOKING_URL=https://wa.me/9477XXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=hello@thesafespaceglobal.com
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/thesafespaceglobal
# Optional: iframe src from a feed widget (SnapWidget, EmbedSocial, etc.). Instagram.com itself cannot be iframed.
# Example: https://snapwidget.com/embed/… (copy only the src URL from their embed code).
NEXT_PUBLIC_INSTAGRAM_EMBED_URL=
# Optional: live grid from Instagram Graph API (server-only; rebuild frontend after changing).
# Instagram Professional (Business/Creator) linked to a Facebook Page → Meta App → long-lived Page token.
# Set INSTAGRAM_GRAPH_USER_ID to your Instagram Business Account ID (Graph API), with token that can read that account's media.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_USER_ID=
STRAPI_API_TOKEN=
REVALIDATE_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Inbox for optional new-order emails (API). Payment slips are reviewed in the admin dashboard without email.
ORDER_NOTIFY_ADMIN_EMAIL=
INTERNSHIP_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# --- Bank transfer (checkout copy, API only) ---
# Shown after a customer generates a bank reference. Use either a single block OR structured fields.
#
# Option A — one multiline string (quote in .env / docker-compose):
# BANK_PAYMENT_INSTRUCTIONS="Account: …\nBank: …\nAccount no: …"
#
# Option B — structured (if ANY value below is set, these are assembled and BANK_PAYMENT_INSTRUCTIONS is ignored):
BANK_ACCOUNT_NAME=
BANK_INSTITUTION=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT_OR_IBAN=
# Extra line(s), e.g. reference text or branch instructions
BANK_PAYMENT_NOTE=
#
# Fallback when all structured fields above are empty:
BANK_PAYMENT_INSTRUCTIONS=Please transfer to: Account Name: The Safe Space Global, Bank: Example Bank, Account No: 0000000000, then share your slip via WhatsApp or email.

# Automatic Strapi seed on container startup is disabled in this project.
# Use manual seeding only when explicitly needed: `docker compose exec backend npm run seed`
STRAPI_SEED_DUMMY_DATA=false

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=
ENCRYPTION_KEY=
